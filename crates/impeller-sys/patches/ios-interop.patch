@@ -26,1 +26,81 @@
 }  // namespace impeller::interop
+
+#include "impeller/renderer/backend/metal/context_mtl.h"
+#include "impeller/renderer/backend/metal/texture_wrapper_mtl.h"
+#include "impeller/toolkit/interop/context.h"
+#include "impeller/toolkit/interop/impeller.h"
+#include "impeller/toolkit/interop/texture.h"
+
+static std::shared_ptr<impeller::Context> ImpastoGetMetalContext(
+    ImpellerContext context) {
+  if (!context) {
+    return nullptr;
+  }
+  auto native = reinterpret_cast<impeller::interop::Context*>(context)
+                    ->GetContext();
+  if (!native ||
+      native->GetBackendType() != impeller::Context::BackendType::kMetal) {
+    return nullptr;
+  }
+  return native;
+}
+
+IMPELLER_EXTERN_C bool ImpastoMetalWaitUntilScheduled(ImpellerContext context) {
+  auto native = ImpastoGetMetalContext(context);
+  if (!native) {
+    return false;
+  }
+  id<MTLCommandBuffer> buffer = impeller::ContextMTL::Cast(native.get())
+                                   ->CreateMTLCommandBuffer("Impasto composition");
+  if (!buffer) {
+    return false;
+  }
+  [buffer commit];
+  [buffer waitUntilScheduled];
+  return buffer.status != MTLCommandBufferStatusError;
+}
+
+IMPELLER_EXTERN_C ImpellerTexture ImpastoMetalTextureNew(
+    ImpellerContext context,
+    const void* handle,
+    void (*release)(void*),
+    void* user_data) {
+  auto owner = std::shared_ptr<void>(user_data, [release](void* data) {
+    if (release) {
+      release(data);
+    }
+  });
+  auto native = ImpastoGetMetalContext(context);
+  auto texture = (__bridge id<MTLTexture>)handle;
+  if (!native || !texture ||
+      texture.device != impeller::ContextMTL::Cast(native.get())->GetMTLDevice() ||
+      texture.textureType != MTLTextureType2D || texture.sampleCount != 1 ||
+      (texture.pixelFormat != MTLPixelFormatBGRA8Unorm &&
+       texture.pixelFormat != MTLPixelFormatRGBA8Unorm)) {
+    return nullptr;
+  }
+
+  impeller::TextureDescriptor desc;
+  desc.storage_mode = impeller::StorageMode::kDevicePrivate;
+  desc.type = impeller::TextureType::kTexture2D;
+  desc.size = {static_cast<impeller::ISize::Type>(texture.width),
+               static_cast<impeller::ISize::Type>(texture.height)};
+  desc.mip_count = 1;
+  desc.usage = impeller::TextureUsage::kShaderRead;
+  auto wrapped = impeller::WrapTextureMTL(desc, handle, [native, owner] {
+    // Keep the Core Video backing lease until earlier Impeller GPU reads finish.
+    id<MTLCommandBuffer> buffer =
+        impeller::ContextMTL::Cast(native.get())->CreateMTLCommandBuffer(
+            "Impasto texture retirement");
+    if (buffer) {
+      [buffer addCompletedHandler:^(id<MTLCommandBuffer>) { (void)owner; }];
+      [buffer commit];
+    }
+  });
+  if (!wrapped || !wrapped->IsValid()) {
+    return nullptr;
+  }
+  return impeller::interop::Create<impeller::interop::Texture>(
+             impeller::Context::BackendType::kMetal, std::move(wrapped))
+      .Leak();
+}
