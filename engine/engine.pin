# Impeller standalone SDK pin. No Dart VM.
#
# hash_kind is `framework` when the URL commit is a Flutter framework commit, or
# `engine` when it is the engine.version commit inside that framework commit.
# Upgrade by sending HEAD for both hashes and keeping the kind that returns 200.
#
# iOS is not in the upstream prebuilt matrix. These names return 404 for this
# commit: ios, ios-arm64, ios-arm64-x86_64-sim. There is no iOS zip to pin.
#
# platform <name> <hash_kind> <commit> <zip sha256>

platform darwin-arm64 framework 77f043bc63196b9979cc09c5b97bb6d9b00be34d fafc41f065b5736841a4f4b57e7bda0ca6599d6583e26714c176179a325574ee
platform android-arm64 framework 77f043bc63196b9979cc09c5b97bb6d9b00be34d 2701357ff535fb595794f09c48c3e03db28f9a73e9b250478ea091c77880d7b8
platform android-x64 framework 77f043bc63196b9979cc09c5b97bb6d9b00be34d 97a87be2b3911fa8a368df98fe558656ba0617fc7fb4051f372c8e7e4caa696b
